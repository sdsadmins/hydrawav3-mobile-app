<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always draws its own launch splash (app icon on a colour)
         before Flutter starts. Give it the v6 splash navy so it blends into
         the app's splash instead of flashing white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
